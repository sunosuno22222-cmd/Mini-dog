# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Cloud Run / AI Studio).
APP_URL="MY_APP_URL"

# DISCORD_BOT_TOKEN: O token do seu Bot do Discord.
# Obtenha em: https://discord.com/developers/applications -> Seu App -> Bot -> Reset Token
DISCORD_BOT_TOKEN=""

# DISCORD_APPLICATION_ID: ID da aplicação / Client ID do Discord
# Obtenha em: Discord Developer Portal -> General Information -> Application ID
DISCORD_APPLICATION_ID=""

# DISCORD_CLIENT_SECRET: Client Secret da aplicação (OAuth2 / Developer Portal)
# Obtenha em: Discord Developer Portal -> OAuth2 -> Client Secret -> Reset Secret
# Usado para credenciais da aplicação Discord sem necessidade de URL de interação!
DISCORD_CLIENT_SECRET=""

# PANEL_PASSWORD: Senha para login no painel de controle web (padrão: "admin")
PANEL_PASSWORD="admin"

# GROQ_API_KEY: Chave de API da Groq para o modelo openai/gpt-oss-120b nos tickets de IA
GROQ_API_KEY=""
